# ── ClickHouse connection ────────────────────────────────────────────────────
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Web UI credentials ───────────────────────────────────────────────────────
GUI_USERNAME=admin

# GUI_PASSWORD_HASH must be a bcrypt hash of your chosen password.
# Generate one with:
#   python3 -c "from passlib.hash import bcrypt; print(bcrypt.hash('yourpassword'))"
# Then paste the output below (starts with $2b$).
GUI_PASSWORD_HASH=

# ── Authentication token signing ─────────────────────────────────────────────
# TOKEN_SECRET must be set — the app refuses to start without it.
# Use any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET=
